# ============================================================================
# software-gym-minimal .env template
# Copy this file to .env and fill in real values: cp .env.example .env
# .env is the single source of truth for model URL / name / API key
# (code only reads environment variables; agent/runtime_env.py::load_env_file
# loads this file at startup).
# ============================================================================

# ----------------------------------------------------------------------------
# [Required] Codex side (design / coding stages: FunctionDesigner / Coder / DevCoder, etc.)
# ----------------------------------------------------------------------------
# Model name (model name or alias visible to the gateway / proxy)
MODEL=gpt-5.5
# Model service endpoint (without /v1; if OPENAI_BASE_URL is empty, ${BASE_URL}/v1 is used)
BASE_URL=<your-model-endpoint>
OPENAI_BASE_URL=<your-model-endpoint>/v1
# API key (falls back to API_KEY if OPENAI_API_KEY is empty; fill at least one)
API_KEY=<your-api-key>
OPENAI_API_KEY=<your-api-key>
# Codex model provider ID (any string that matches the scaffold-generated codex config)
MODEL_PROVIDER=<provider-id>
# Optional: context window / max output tokens (written into codex config; leave empty to omit)
MODEL_CONTEXT_WINDOW=258400
MODEL_MAX_OUTPUT_TOKENS=32768
# Optional: Codex channel affinity (comma-separated model aliases pinned by style hash; falls back to MODEL)
SOFTWAREGYM_CODEX_CHANNEL_ALIASES=

# ----------------------------------------------------------------------------
# [Required, for GUIEval] Python environment used for evaluation (conda, not portable)
# ----------------------------------------------------------------------------
APPEVAL_PYTHON=/opt/miniconda3/envs/osworld/bin/python
# Use the osworld conda environment's Python uniformly. This package no longer
# ships its own venv; orchestration and GUIEval share this interpreter, and
# missing packages have been installed there.
SOFTWAREGYM_PYTHON=/opt/miniconda3/envs/osworld/bin/python

# ----------------------------------------------------------------------------
# [Required, for GUIEval] OSWorld container
# ----------------------------------------------------------------------------
# Private base image (NOT shipped with this package; place the qcow2 under
# docker/base/ yourself — see README. Relative paths are resolved against the
# package root, and absolute paths are also accepted)
OSWORLD_BASE_IMAGE=docker/base/Ubuntu_osworld_minimal.qcow2
# Optional: container resources and timeouts (defaults: cpu=code built-in,
# ram e.g. 4G, health check 30 attempts, request 10s)
OSWORLD_CPU_CORES=4
OSWORLD_RAM_SIZE=4G
OSWORLD_HEALTH_ATTEMPTS=90
OSWORLD_REQUEST_TIMEOUT=60

# ----------------------------------------------------------------------------
# GUIEval GUIAgent model (gpt54 implementation)
# When GUIAGENT_* are empty, falls back as:
#   model = APPEVAL_LLM_MODEL -> MODEL
#   key / url = OPENAI_API_KEY / OPENAI_BASE_URL
# Configure separately only when the GUIAgent must be isolated from Codex.
# ----------------------------------------------------------------------------
APPEVAL_AGENT_IMPL=gpt54            # gpt54 | seed
APPEVAL_LLM_MODEL=gpt-5.5
APPEVAL_MAX_STEPS=60
# GUIAGENT_MODEL=gpt-5.5
# GUIAGENT_OPENAI_BASE_URL=<your-model-endpoint>/v1
# GUIAGENT_OPENAI_API_KEY=<your-api-key>
# Optional: GUI screenshot size (e.g. 1366x768; leave empty for the default)
GUIEVAL_IMAGE_SIZE=
# Optional: GUIEval channel affinity (comma-separated aliases pinned by lane
# rotation; falls back to the model above if empty)
SOFTWAREGYM_GUIAGENT_CHANNEL_ALIASES=

# ----------------------------------------------------------------------------
# Seed implementation only (required when APPEVAL_AGENT_IMPL=seed:
# executor model / key / endpoint; judge reuses executor config by default,
# fill SEED_JUDGE_* only when judge needs to be independent)
# ----------------------------------------------------------------------------
SEED_EXEC_MODEL=
SEED_EXEC_API_KEY=
SEED_EXEC_BASE_URL=
SEED_EXEC_REASONING_EFFORT=high
SEED_EXEC_REQUEST_RETRIES=2
SEED_EXEC_ALL_IMAGES=0
SEED_REQUEST_TIMEOUT=180
SEED_SLEEP_AFTER_EXEC=1.0
SEED_HISTORY_N=5
SEED_MAX_TRAJECTORY_LENGTH=100
SEED_MAX_RETRIES=2
SEED_LOOP_DETECTION=1
SEED_LOOP_SAME_ACTION_REPEATS=2
SEED_LOOP_NO_PROGRESS_STEPS=4
SEED_LOOP_MIN_VISUAL_CHANGE=0.15
SEED_JUDGE_USE_EXEC_CONFIG=1
# SEED_JUDGE_MODEL=
# SEED_JUDGE_API_KEY=
# SEED_JUDGE_BASE_URL=
SEED_JUDGE_REASONING_EFFORT=high
SEED_JUDGE_MAX_TOKENS=8000
SEED_JUDGE_ATTEMPTS=2
SEED_JUDGE_HISTORY_IMAGES=10
SEED_JUDGE_ALL_IMAGES=0
SEED_JUDGE_INCLUDE_INITIAL=0
SEED_JUDGE_IMAGE_SIZE=
SEED_JUDGE_REQUEST_TIMEOUT=180
SEED_JUDGE_REQUEST_RETRIES=2
SEED_JUDGE_RETRY_BACKOFF_SECONDS=2

# ----------------------------------------------------------------------------
# [Optional] Host tool locations (only needed when not on PATH)
# ----------------------------------------------------------------------------
# Absolute path to the .NET 8 SDK `dotnet` executable. Lookup order in
# agent/loop_controller/avalonia_blueprint.py: PATH -> SOFTWAREGYM_DOTNET ->
# ~/.local/dotnet8/dotnet -> /tmp/dotnet8/dotnet
#SOFTWAREGYM_DOTNET=
# Absolute path to the `vncdo` executable used for VNC screenshots in GUIEval.
# Lookup order in agent/eval/gui_agent_adapter.py: SOFTWAREGYM_VNCDO -> PATH
#SOFTWAREGYM_VNCDO=

# ----------------------------------------------------------------------------
# Network / environment behavior (keep as below)
# ----------------------------------------------------------------------------
# 1 = child processes always clear HTTP(S)_PROXY and set NO_PROXY=*
# (required when calling localhost / intranet endpoints or whitelist backends;
# set to 0 and export HTTPS_PROXY if your model endpoint needs a proxy)
SOFTWAREGYM_NO_PROXY=1
NO_PROXY=*
no_proxy=*
# Guest VM proxy (see README "Proxy / networking"). Default: point the OSWorld
# guest at http://172.17.0.1:7890 (docker bridge gateway) and relay it to the
# host proxy on 127.0.0.1:7890. Set empty or OSWORLD_VM_PROXY_DISABLE=1 to skip.
#OSWORLD_VM_PROXY=http://172.17.0.1:7890
#OSWORLD_VM_PROXY_DISABLE=0
#OSWORLD_VM_PROXY_SCOPE=both        # both | cli | gui
# 1 = run_eval child processes reload .env on each run
# (changes to .env take effect without restarting GUIEval)
SOFTWAREGYM_ENV_OVERRIDE=1
